#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOVE_UP    MOVE_Y(-1000)
#define MOVE_DOWN  MOVE_Y(1000)
#define MOVE_LEFT  MOVE_X(-1000)
#define MOVE_RIGHT MOVE_X(1000)

/ {
    macros {
        sleep: sleep {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(X)>,
                <&macro_wait_time 75>,
                <&kp U>,
                <&macro_wait_time 75>,
                <&kp S>;

            label = "SLEEP";
        };
    };

    behaviors {
        mouse_hold: mouse_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_HOLD";
            bindings = <&mmv>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <125>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC            &kp N1  &kp N2  &kp N3        &kp N4              &kp N5                                      &kp N6         &kp N7         &kp N8      &kp N9   &kp N0    &kp EQUAL
&lt 2 TAB          &kp Q   &kp W   &kp E         &kp R               &kp T                                       &kp Y          &kp U          &kp I       &kp O    &kp P     &lt 2 MINUS
&lt (1) LC(LS(M))  &kp A   &kp S   &kp D         &kp F               &kp G                                       &kp H          &kp J          &kp K       &kp L    &kp SEMI  &lt 1 APOSTROPHE
&kp LSHFT          &kp Z   &kp X   &kp C         &kp V               &kp B      &kp LEFT_BRACKET    &kp RBKT     &kp N          &kp M          &kp COMMA   &kp DOT  &kp FSLH  &kp RSHFT
                                   &kp LEFT_GUI  &mt LEFT_ALT ENTER  &kp LCTRL  &lt 1 SPACE         &lt 1 ENTER  &kp BACKSPACE  &kp RIGHT_ALT  &kp K_LOCK
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp TILDE            &kp LC(A)        &kp LC(H)     &kp LC(F)   &kp LC(T)         &kp HOME                                          &kp HOME          &kp C_PREV                  &kp C_PLAY_PAUSE              &kp C_NEXT                    &kp C_MUTE            &kp C_VOL_UP
&kp GRAVE            &kp LC(X)        &kp LA(LEFT)  &kp UP      &kp LA(RIGHT)     &kp PAGE_UP                                       &kp PAGE_UP       &mkp LCLK                   &mouse_hold MOVE_UP UP_ARROW  &mkp RCLK                     &kp PRINTSCREEN       &kp C_VOLUME_DOWN
&kp LC(V)            &kp LC(C)        &kp LEFT      &kp DOWN    &kp RIGHT         &kp PAGE_DOWN                                     &kp PAGE_DOWN     &mouse_hold MOVE_LEFT LEFT  &mouse_hold MOVE_DOWN DOWN    &mouse_hold MOVE_RIGHT RIGHT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&mt LEFT_SHIFT CAPS  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH    &kp DOLLAR        &kp END        &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp END           &kp PIPE                    &kp COLON                     &kp SEMI                      &kp BACKSLASH         &mt LEFT_SHIFT CAPSLOCK
                                                    &kp ESCAPE  &mt LEFT_ALT TAB  &mt LCTRL DEL  &trans            &trans           &mt RCTRL DELETE  &mt RIGHT_ALT TAB           &kp ESCAPE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&bt BT_CLR  &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3  &bt BT_SEL 4                          &trans         &kp N7  &kp N8  &kp N9   &kp PLUS   &trans
&kp F6      &kp F7            &kp F9             &kp F10            &kp F11       &kp F12                               &kp C_BRI_INC  &kp N5  &kp N6  &kp N7   &kp MINUS  &msc SCRL_UP
&kp F1      &kp F2            &kp F3             &kp F4             &kp F5        &kp F6                                &kp C_BRI_DEC  &kp N1  &kp N2  &kp N3   &kp STAR   &msc SCRL_DOWN
&trans      &ext_power EP_ON  &ext_power EP_OFF  &ext_power EP_TOG  &trans        &trans        &kp LG(V)    &kp LG(V)  &trans         &trans  &kp N0  &kp DOT  &kp SLASH  &trans
                                                 &trans             &trans        &trans        &soft_off    &soft_off  &trans         &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
&mmv {
    time-to-max-speed-ms = <300>;
    acceleration-exponent = <1>;
    delay-ms = <0>;
};